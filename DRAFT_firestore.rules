rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Catch-all: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isEmailVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "ayhkuc1@gmail.com"
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---
    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'type', 'origin', 'weight', 'priceAud']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 500 &&
             data.type in ["Black Opal", "Boulder Opal", "Crystal Opal", "White Opal"] &&
             data.origin is string && data.origin.size() <= 500 &&
             data.weight is number && data.weight > 0 &&
             data.priceAud is number && data.priceAud >= 0;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'customerName', 'customerEmail', 'items', 'totalAud', 'status']) &&
             data.id is string &&
             data.customerName is string && data.customerName.size() > 0 &&
             data.customerEmail is string && data.customerEmail.matches('^.+@.+\\..+$') &&
             data.items is list && data.items.size() > 0 &&
             data.totalAud is number && data.totalAud >= 0 &&
             data.status in ["Pending Delivery", "In Escrow Transit", "Delivered & Verified"];
    }

    function isTerminalStatus(status) {
      return status == "Delivered & Verified";
    }

    // --- Collections ---

    match /products/{productId} {
      allow read: if true; // Public catalog
      
      allow create: if isAdmin() && isValidProduct(incoming()) && productId == incoming().id;
      
      allow update: if isAdmin() && isValidProduct(incoming()) && (
        // Action: Generic Update
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'type', 'origin', 'weight', 'dimensions', 'priceAud', 'priceUsd', 
          'bodyTone', 'brightness', 'shape', 'pattern', 'playOfColor', 'serialNumber', 'isRare', 'imageUrl'
        ])
      );
      
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      // Create: Guest checkout allowed
      allow create: if isValidOrder(incoming()) && orderId == incoming().id;
      
      // Update: Only admin can update status, and only if not in terminal state
      allow update: if isAdmin() && isValidOrder(incoming()) && (
        !isTerminalStatus(existing().status) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status'])
      );
      
      // Read/List: Only admin can see sales ledger
      allow get, list: if isAdmin();
      
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      // Write to admins is restricted (managed via console or system)
      allow write: if false; 
    }
  }
}
