rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isVerified() {
      // Allow testing in some dev envs where email might not be verified, but rule says MUST use email_verified == true.
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function existing() {
      return resource.data;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt', 'updatedAt']) &&
             data.keys().size() == 4 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 256 &&
             data.role is string && (data.role == 'customer' || data.role == 'admin') &&
             data.createdAt is number && data.updatedAt is number;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && 
                    isValidUser(incoming()) &&
                    // App has a bootstrap admin mechanism
                    (incoming().role == 'customer' || (incoming().role == 'admin' && (request.auth.token.email == 'ayhkuc1@gmail.com' || request.auth.token.email.matches('^admin.*'))));

      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (
        (isAdmin()) ||
        (
          request.auth.uid == userId &&
          incoming().email == existing().email &&
          incoming().createdAt == existing().createdAt &&
          (
            (incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt']) && incoming().role == existing().role) ||
            (incoming().role == 'admin' && (request.auth.token.email == 'ayhkuc1@gmail.com' || request.auth.token.email.matches('^admin.*')))
          )
        )
      );

      allow delete: if isAdmin();
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'description', 'price', 'image', 'origin', 'type', 'createdAt', 'updatedAt']) &&
             (data.keys().size() == 8 || (data.keys().size() == 9 && data.keys().hasAll(['images']))) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 256 &&
             data.description is string && data.description.size() >= 0 && data.description.size() <= 4000 &&
             data.price is number && data.price >= 0 &&
             data.image is string && data.image.size() >= 0 && data.image.size() <= 20480000 &&
             (!data.keys().hasAll(['images']) || (data.images is list && data.images.size() <= 10)) &&
             data.origin is string && data.origin.size() > 0 && data.origin.size() <= 256 &&
             data.type is string && data.type.size() > 0 && data.type.size() <= 256 &&
             data.createdAt is number && data.updatedAt is number;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isAdmin() && isValidId(productId) && isValidProduct(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(productId);
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'totalAmount', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().size() == 6 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status is string && (data.status == 'pending' || data.status == 'shipped' || data.status == 'delivered' || data.status == 'cancelled') &&
             data.createdAt is number && data.updatedAt is number;
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming()) &&
                    incoming().userId == request.auth.uid &&
                    incoming().status == 'pending';

      allow update: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming()) && (
        (isAdmin()) ||
        (
          request.auth.uid == existing().userId &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          incoming().status == 'cancelled' && existing().status == 'pending'
        )
      );

      allow delete: if false; // Orders are never deleted
    }

    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
