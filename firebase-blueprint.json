{
  "entities": {
    "OpalProduct": {
      "title": "Opal Product",
      "description": "An authentic Australian opal gemstone listed in the boutique catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["Black Opal", "Boulder Opal", "Crystal Opal", "White Opal"] },
        "origin": { "type": "string" },
        "weight": { "type": "number" },
        "dimensions": { "type": "string" },
        "priceEur": { "type": "number" },
        "priceUsd": { "type": "number" },
        "bodyTone": { "type": "string" },
        "brightness": { "type": "string" },
        "shape": { "type": "string" },
        "pattern": { "type": "string" },
        "playOfColor": { "type": "string" },
        "serialNumber": { "type": "string" },
        "isRare": { "type": "boolean" },
        "image": { "type": "string" },
        "additionalImages": { "type": "array" },
        "youtubeUrl": { "type": "string" }
      },
      "required": ["id", "name", "type", "origin", "weight", "priceEur"]
    },
    "OpalOrder": {
      "title": "Opal Order",
      "description": "A purchase record for one or more opal gemstones.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerAddress": { "type": "string" },
        "items": { "type": "array" },
        "totalEur": { "type": "number" },
        "totalUsd": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending Delivery", "In Escrow Transit", "Delivered & Verified"] }
      },
      "required": ["id", "customerName", "customerEmail", "items", "totalEur", "status"]
    }
  },
  "firestore": {
    "products/{productId}": {
      "schema": "OpalProduct",
      "description": "A collection of high-grade Australian opals available for purchase."
    },
    "orders/{orderId}": {
      "schema": "OpalOrder",
      "description": "A ledger of completed sales transactions."
    }
  }
}
